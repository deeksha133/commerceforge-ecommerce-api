{
  "info": {
    "name": "CommerceForge API",
    "description": "Ready-to-run requests for the CommerceForge e-commerce backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "token", "value": ""},
    {"key": "productId", "value": "1"},
    {"key": "adminEmail", "value": ""},
    {"key": "adminPassword", "value": ""}
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"student@example.com\",\n  \"password\": \"YOUR_PASSWORD\"\n}"}, "url": "{{baseUrl}}/api/auth/register"}
        },
        {
          "name": "Admin Login",
          "event": [{"listen": "test", "script": {"exec": ["pm.environment.set('token', pm.response.json().access_token);"]}}],
          "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"}, "url": "{{baseUrl}}/api/auth/login"}
        },
        {
          "name": "My Profile",
          "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "url": "{{baseUrl}}/api/auth/me"}
        }
      ]
    },
    {
      "name": "Catalog and Cart",
      "item": [
        {"name": "Search Products", "request": {"method": "GET", "url": "{{baseUrl}}/api/products?search=keyboard&in_stock=true"}},
        {"name": "Add to Cart", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 2\n}"}, "url": "{{baseUrl}}/api/cart/items"}},
        {"name": "View Cart", "request": {"method": "GET", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "url": "{{baseUrl}}/api/cart"}},
        {"name": "Checkout", "request": {"method": "POST", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"shipping_address\": \"221 Market Street, Bengaluru\",\n  \"coupon_code\": \"WELCOME10\"\n}"}, "url": "{{baseUrl}}/api/orders/checkout"}}
      ]
    }
  ]
}
